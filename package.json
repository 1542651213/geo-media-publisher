{
  "name": "codex-media-publisher",
  "version": "1.1.9",
  "private": true,
  "main": "out/main/main.js",
  "description": "Windows AI 多平台内容运营工作台 V1.1.9 Sohu article editor and real publish acceptance",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "installer": "pnpm rebuild:native && pnpm build && electron-builder --win nsis --x64",
    "package:dir": "pnpm rebuild:native && pnpm build && electron-builder --win dir --x64 && pnpm verify:packaged-migrations",
    "verify:packaged-migrations": "tsx scripts/verify-packaged-migrations.mts",
    "test:stress": "pnpm rebuild better-sqlite3 && tsx scripts/stress-test.mts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/test-with-native.mts",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate-dev.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -v 37.10.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.34.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.4",
    "playwright-core": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.0.17"
  },
  "build": {
    "appId": "com.geo.mediapublisher",
    "productName": "Geo Media Publisher",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json", "node_modules/**/*"],
    "extraResources": [
      { "from": "packages/db/migrations", "to": "packages/db/migrations" },
      { "from": "PLATFORMS.csv", "to": "PLATFORMS.csv" }
    ],
    "asarUnpack": ["node_modules/better-sqlite3/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
